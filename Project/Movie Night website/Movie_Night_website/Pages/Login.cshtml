@page
@model Movie_Night_website.Pages.LoginModel
@{
	Layout = null;
	<link rel="stylesheet" href="~/css/Login.css" />

}

<div class="glass-container">
	<div class="login-box">
		<h2>Login</h2>
		<form method="POST">
			<input asp-for="Username "type="text" id="username" required placeholder="Username" />
			<input asp-for="Password" type="password" id="password" required placeholder="Password" /> 
			<div class="options">
				<input type="checkbox" id="remember" name="remember" /> 

				<label for="remember">Remember me</label> <!-- Cookie Toggler? -->
				<a href="#">Forgot Password?</a> <!-- Will add this function later -->
			</div>
			<button type="submit">Login</button>
			<p>Do not have an account? <a href="/Register" id="register">Register</a> </p>
		</form>

	</div>

</div>
