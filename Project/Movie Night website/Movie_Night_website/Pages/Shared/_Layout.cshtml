<!DOCTYPE html>
<html lang="en">
<head>
    
    <style>
        html,body
        {
            height : 100vh;
        }

        .nav-item 
        {
            background-color: #CC6BB1;
        }
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Movie_Night_website</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Movie_Night_website.styles.css" asp-append-version="true" />
</head>
<body>
	<div class="d-flex page " >
        <div class="menubar">
            <ul class="nav flex-column ">
                <li class="nav-item my-2 text-center">
                    <a class="nav-link " aria-current="page" href="/Home">Home</a>
                </li>
                <li class="nav-item my-2 text-center">
                    <a class="nav-link" href="/Addmovie">Add Movie</a>
                </li>
                <li class="nav-item my-2 text-center">
                    <a class="nav-link" href="/Vote">Vote</a>
                </li>
                <li class="nav-item my-2 text-center">
                    <a class="nav-link" href ="/Organizer">Organizing Tool</a>
                </li>
                <li class="nav-item my-2 text-center">
                    <a class="nav-link" href="/Library">Library</a>
                </li>
                <li class="nav-item my-2 text-center">
                    <a class="nav-link" href="/Roll">Roll!</a>
                </li>

            </ul>
        </div>
        <div class="content flex-grow-1">
            <main role="main" class="">
                @RenderBody()
            </main>
        </div>
    </div>




    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
