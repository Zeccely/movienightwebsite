@page
@model OrganizerModel
@{
    <link rel="stylesheet" href="~/css/Organizer.css" />
}
<div class="container text-center">
      <form method="Post">
      <div class="row g-2 g-lg-3">
			<div class="col-2 ">
				<div class="p-2 blur">
          <h1>Users</h1>

          @foreach (var user in Model.UserList)
          {
              <div class="form-check">
              <input class="form-check-input" type="checkbox" value="@user.UserID" id="@user.UserID">
              <label class="form-check-label" for="@user.UserID">
              @user.Username
              </label>
            </div>
          }

        </div>
        </div>
		<div class="col-10 blur">
          <div class="">
          <h1>Media</h1>
          <div class="row row-cols-6 g-2">

                    @foreach (var media in Model.MediaList) 
            {
                <div class="col ">
                    <div class="bordery">
                        <h5 class="card-title">@media.GetTitle()</h5>
                        <h6 class="contributor">@media.Contributor?.Username</h6>
                        <input type="radio" asp-for="ChosenMediaID" value="@media.MediaID" />
                    </div>
                </div>
            }
          </div>
          </div>
        </div>
      </div>
      <div class="row">
      <div class="col d-flex justify-content-center">

      <button type="submit" class="btn btn-primary">Submit</button>
      </div>
      </div>
    </form>
    </div>
 



@{
}

