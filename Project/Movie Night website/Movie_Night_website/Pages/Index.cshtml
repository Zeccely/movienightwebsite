@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to the movie night website </h1>
    <h2>movies in database = @Model.MovieCount</h2>
    <p>
        Rules:

        - Add movies to the pool of suggestions
        - Movies enter the list after 2 upvotes
        - Every Thursday the movie is rolled by Prawr
        - Rolled movies must follow 2 rules as well: Person who suggested must be present and person who really wants to watch is is present.
    </p>
</div>
