@page 
@model AddMovieModel
@{
}
<div>
    <h1> Add movie for voting! </h1>
    <form method="post" id="AddMovieForm">
        <div class="mb-3">
            <label class="form-label">Movie Title</label>
            <input asp-for="Title" class="form-control" id="Title" name="Title" required="">

        </div>
        <div class="mb-3">
            <label for="TrailerURL" class="form-label">Movie trailer URL</label>
            <input asp-for="TrailerURL" type="url" class="form-control" id="TrailerURL" name="TrailerURL" required="">
        </div>
        <div class="mb-3">
			<label class="form-label">What are you adding?</label>
            <select asp-for="MediaType" form="AddMovieForm">
                <option value="Movie">Movie</option>
                <option value="Series">Series</option>
            </select>
            <div>
				<button type="submit" class="btn btn-primary">Submit</button>
            </div>
			
        </div>

    </form>
	
</div>

