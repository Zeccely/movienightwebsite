@page
@model Movie_Night_website.Pages.VoteModel

@foreach (var media in Model.MediaList)
{
    <form method="post">
        <div class="MediaCard" style="width: 18rem;">

            <div class="card-body">
                <h5 class="card-title">@media.Title</h5>
                <h6 class="card-subtitle mb-2 text-body-secondary">@media.Contributor.Username</h6>
                <a href="@media.TrailerURL" target="_blank">Watch Trailer</a>

                <label>
                    <input type="checkbox" id="thumbs-checkbox">
                    <span class="thumbs-checkbox">
                        <span class="thumbs-up" value="true">&#128076;</span>
                        <span class="thumbs-down" value="false">&#128078;</span>
                    </span>
                </label>

                <input type="hidden" id="MediaId" name="MediaId" value="@media.MediaID" />

                <button type="submit">Submit Vote</button>

            </div>
        </div>
    </form>
}
@{

}
