@page
@model Movie_Night_website.Pages.VoteModel
@{

    <link rel="stylesheet" href="~/css/Vote.css" />

}
<div class="VoteDisplay">
    @{int id = 0;}
    @foreach (var media in Model.MediaList)
    {
        id++; 
        <form class="fullcard" method="post">

        <div class="MediaCard">

            <div class="card-body">
                <h5 class="card-title">@media.Title</h5>
                <h6 class="contributor">@media.Contributor.Username</h6>
                <a href="@media.TrailerURL" target="_blank">Watch Trailer</a>

                    <label class="custom-checkbox">
                        <input type="checkbox" asp-for="Vote" id="vote_@id">
                        <span class="custom-checkbox">
                            <span class="thumbs-up">&#128076;</span>
                            <span class="thumbs-down">&#128078;</span>
                        </span>
                    </label>

                <input type="hidden" id="MediaId" name="MediaId" value="@media.MediaID" />

                <button type="submit">Submit Vote</button>

            </div>
        </div>
    </form>
}
</div>
@{

}
