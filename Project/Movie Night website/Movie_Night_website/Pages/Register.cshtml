@page
@model Movie_Night_website.Pages.RegisterModel
@{
	Layout = null;
	<link rel="stylesheet" href="~/css/Register.css" />
}
<div class="glass-container">
	<div class="Register-box">
		<h2>Register</h2>
		<form method="POST">

			<input asp-for="NewUsername" type="text" id="NewUsername" required placeholder="Username" />
			<input asp-for="NewPassword" type="password" id="NewPassword" required placeholder="Password" />
			
			<button name="registerbtn" id="registerbtn" type="submit"> Register </button>
		</form>
		
		<p>Already have an account? <a href="/Login" id="register">Go to Login</a> </p>

	</div>

</div>

}
